# ML service — локальная LLM с открытыми весами (Ollama). По умолчанию включена и запускается в compose.
# Отключить: оставить OLLAMA_URL пустым (OLLAMA_URL=). На Mac быстрее нативная Ollama: http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:1.7b
LLM_TEXT_TIMEOUT_SECONDS=30
LLM_INTENT_TIMEOUT_SECONDS=15
